{
  "name": "doot-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"web,signal\" -c \"cyan,magenta\" \"pnpm --filter @doot/web dev\" \"pnpm --filter @doot/signaling-server dev\"",
    "dev:web": "pnpm --filter @doot/web dev",
    "dev:signal": "pnpm --filter @doot/signaling-server dev",
    "build": "pnpm --filter @doot/web build",
    "build:sw": "pnpm --filter @doot/web build:sw",
    "test:signal": "pnpm --filter @doot/signaling-server test",
    "test": "pnpm --filter @doot/signaling-server test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
