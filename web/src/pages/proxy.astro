---
import Layout from "../layouts/Layout.astro";
import DootLogo from "../components/DootLogo.astro";
---

<Layout>
    <div class="proxy-page">
        <!-- Minimal Header matching doot style -->
        <header class="header">
            <a href="/" class="brand">
                <DootLogo size={44} />
                <span class="brand-name">doot</span>
            </a>

            <div class="room-indicator mono-font">
                <span id="room-label">room:</span>
                <strong id="room-id">—</strong>
            </div>
        </header>

        <!-- Tab Navigation matching room.astro style -->
        <div class="tab-nav">
            <button id="tab-btn-host" type="button" class="tab-btn active">
                <span>Host</span>
            </button>
            <button id="tab-btn-client" type="button" class="tab-btn">
                <span>Client</span>
            </button>
        </div>

        <!-- Main Content Panes -->
        <main class="proxy-content">
            <!-- Host Panel -->
            <div id="tab-pane-host" class="tab-pane">
                <div class="mobile-peer">
                    <p id="host-mobile-peer-label" class="mobile-peer-label">
                        no clients connected
                    </p>
                </div>

                <div class="proxy-layout">
                    <div class="proxy-main-col">
                        <div class="card">
                            <div class="field-group">
                                <div class="field-header">
                                    <label for="host-target-input" class="label"
                                        >LOCAL SERVER ADDRESS</label
                                    >
                                </div>
                                <input
                                    id="host-target-input"
                                    type="text"
                                    value="http://localhost:4321"
                                    class="input mono-font"
                                    placeholder="http://localhost:4322"
                                />
                            </div>
                        </div>
                    </div>

                    <aside class="peer-panel host-peer-panel">
                        <h2 class="panel-title">Connected Clients</h2>
                        <div class="client-count-wrapper">
                            <span
                                id="host-peer-name"
                                class="client-count-number">0</span
                            >
                        </div>
                    </aside>
                </div>

                <!-- Host Request Log (Last 50 requests) -->
                <div class="log-section">
                    <div class="log-header">
                        <span class="log-title mono-font">REQUESTS</span>
                        <button
                            id="clear-logs-btn"
                            type="button"
                            class="btn-clear mono-font">Clear</button
                        >
                    </div>
                    <div class="log-grid-container">
                        <div id="log-empty" class="log-empty">
                            No requests forwarded yet
                        </div>
                        <div
                            id="log-grid"
                            class="log-grid"
                            style="display: none;"
                        >
                            <div class="log-grid-header">
                                <div class="col-id">#</div>
                                <div class="col-status">STATUS</div>
                                <div class="col-method">METHOD</div>
                                <div class="col-path">PATH</div>
                                <div class="col-time">TIME</div>
                            </div>
                            <div id="log-rows" class="log-rows"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Client Panel -->
            <div id="tab-pane-client" class="tab-pane" hidden>
                <div class="mobile-peer">
                    <p id="client-mobile-peer-label" class="mobile-peer-label">
                        Waiting for a host...
                    </p>
                </div>

                <div class="client-layout">
                    <div class="client-main-col">
                        <div class="card">
                            <div class="field-group">
                                <div class="field-header">
                                    <label class="label">TUNNEL ADDRESS</label>
                                </div>
                                <div class="input-with-action">
                                    <input
                                        id="tunnel-url-input"
                                        type="text"
                                        readonly
                                        class="input mono-font"
                                    />
                                    <button
                                        id="copy-url-btn"
                                        type="button"
                                        class="btn btn-secondary"
                                    >
                                        Copy
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="actions-row">
                            <a
                                id="launch-btn"
                                href="#"
                                target="_blank"
                                rel="opener"
                                class="btn btn-primary btn-client-theme"
                            >
                                <span>Open Tunneled App</span>
                                <iconify-icon icon="mdi:open-in-new"
                                ></iconify-icon>
                            </a>
                        </div>
                    </div>

                    <aside class="peer-panel">
                        <h2 class="panel-title">Host</h2>
                        <p id="client-peer-name" class="peer-name">
                            Waiting for a host...
                        </p>
                    </aside>
                </div>
            </div>
        </main>
    </div>
</Layout>

<script>
    import { SS } from "../js/signaling";
    import { Peers, setRole, knownRoomPeers, PEER_ID } from "../js/peers";
    import { handleClientProxyRequest } from "../js/proxy/client";
    import { setTargetHost, RequestLogs } from "../js/proxy/host";

    const params = new URLSearchParams(window.location.search);
    const roomName = params.get("name") || "proxy-room";

    const roomIdEl = document.getElementById("room-id");
    if (roomIdEl) roomIdEl.textContent = roomName;

    // Mode: Default is always 'client'. A client chooses to become a 'proxy' (host).
    let mode: "proxy" | "client" =
        params.get("mode") === "proxy" || params.get("role") === "proxy"
            ? "proxy"
            : "client";

    // Join room with initial role metadata
    setRole(mode);
    SS.joinRoom(roomName, { role: mode });

    // Elements
    const tabBtnHost = document.getElementById("tab-btn-host");
    const tabBtnClient = document.getElementById("tab-btn-client");
    const tabPaneHost = document.getElementById("tab-pane-host");
    const tabPaneClient = document.getElementById("tab-pane-client");
    const hostTargetInput = document.getElementById(
        "host-target-input",
    ) as HTMLInputElement | null;
    const tunnelUrlInput = document.getElementById(
        "tunnel-url-input",
    ) as HTMLInputElement | null;
    const copyUrlBtn = document.getElementById("copy-url-btn");
    const launchBtn = document.getElementById(
        "launch-btn",
    ) as HTMLAnchorElement | null;
    const hostPeerName = document.getElementById("host-peer-name");
    const hostMobilePeerLabel = document.getElementById(
        "host-mobile-peer-label",
    );
    const clientPeerName = document.getElementById("client-peer-name");
    const clientMobilePeerLabel = document.getElementById(
        "client-mobile-peer-label",
    );

    // Tunnel param: ?doot_tunnel=<roomId>
    const tunnelUrl = `${window.location.origin}?doot_tunnel=${encodeURIComponent(roomName)}`;

    if (tunnelUrlInput) tunnelUrlInput.value = tunnelUrl;
    if (launchBtn) {
        launchBtn.href = tunnelUrl;
        launchBtn.addEventListener("click", (e) => {
            e.preventDefault();
            window.open(tunnelUrl, "_blank");
        });
    }

    function updateMode(newMode: "proxy" | "client") {
        mode = newMode;
        setRole(mode);
        SS.sendSignal({
            type: "update_metadata",
            room_id: roomName,
            metadata: { role: mode },
        });

        // Store tab state in URL so reloading opens the correct tab!
        const curUrl = new URL(window.location.href);
        curUrl.searchParams.set("mode", mode);
        window.history.replaceState(null, "", curUrl.toString());

        const isHost = mode === "proxy";
        tabBtnHost?.classList.toggle("active", isHost);
        tabBtnClient?.classList.toggle("active", !isHost);

        if (tabPaneHost) tabPaneHost.hidden = !isHost;
        if (tabPaneClient) tabPaneClient.hidden = isHost;
    }

    updateMode(mode);

    tabBtnHost?.addEventListener("click", () => updateMode("proxy"));
    tabBtnClient?.addEventListener("click", () => updateMode("client"));

    // Host Request Logs (Store & display last 50)
    const logGrid = document.getElementById("log-grid");
    const logRows = document.getElementById("log-rows");
    const logEmpty = document.getElementById("log-empty");
    const clearLogsBtn = document.getElementById("clear-logs-btn");

    clearLogsBtn?.addEventListener("click", () => {
        RequestLogs.clear();
    });

    RequestLogs.onchange((entries) => {
        if (!entries || entries.length === 0) {
            if (logGrid) logGrid.style.display = "none";
            if (logEmpty) logEmpty.style.display = "block";
            if (logRows) logRows.innerHTML = "";
            return;
        }

        if (logEmpty) logEmpty.style.display = "none";
        if (logGrid) logGrid.style.display = "flex";

        if (logRows) {
            logRows.innerHTML = entries
                .map((entry) => {
                    const is2xx = entry.status >= 200 && entry.status < 300;
                    const is3xx = entry.status >= 300 && entry.status < 400;
                    const is4xx = entry.status >= 400 && entry.status < 500;
                    const statusColorClass = is2xx
                        ? "status-2xx"
                        : is3xx
                          ? "status-3xx"
                          : is4xx
                            ? "status-4xx"
                            : "status-5xx";

                    return `
                        <div class="log-grid-row">
                            <div class="col-id">${entry.id}</div>
                            <div class="col-status ${statusColorClass}">${entry.status}</div>
                            <div class="col-method">${entry.method}</div>
                            <div class="col-path" title="${entry.path}">${entry.path}</div>
                            <div class="col-time">${entry.durationMs}ms</div>
                        </div>
                    `;
                })
                .join("");
        }
    });

    // Host target input change
    hostTargetInput?.addEventListener("change", () => {
        if (hostTargetInput.value) {
            setTargetHost(hostTargetInput.value.trim());
        }
    });

    // Copy URL
    copyUrlBtn?.addEventListener("click", () => {
        if (tunnelUrlInput) {
            navigator.clipboard.writeText(tunnelUrlInput.value);
            copyUrlBtn.textContent = "Copied";
            setTimeout(() => {
                copyUrlBtn.textContent = "Copy";
            }, 1500);
        }
    });

    // Broadcast channel to notify waiting tunnel tabs reactively
    const tunnelChannel =
        "BroadcastChannel" in window
            ? new BroadcastChannel("doot_tunnel")
            : null;

    // Helper to update client peer UI
    function updateClientPeerUI(peerId: string | null) {
        if (!peerId) {
            if (clientPeerName)
                clientPeerName.textContent = "Waiting for a host...";
            if (clientMobilePeerLabel)
                clientMobilePeerLabel.innerHTML = `Waiting for a host...`;
            return;
        }

        const formatted = `${peerId.slice(0, 8)}`;
        if (clientPeerName) clientPeerName.textContent = formatted;
        if (clientMobilePeerLabel) {
            clientMobilePeerLabel.innerHTML = `<span style="color: var(--text-primary); margin-right: 5px;">Host</span> <span class="peer-id-val">${formatted}</span>`;
        }
    }

    // Helper to update host peer UI
    function updateHostPeerUI(count: number) {
        if (hostPeerName) hostPeerName.textContent = String(count);
        if (hostMobilePeerLabel) {
            if (count > 0) {
                hostMobilePeerLabel.innerHTML = `<span style="color: var(--text-primary); margin-right: 5px;">Connected Clients</span> <span class="peer-id-val">${count}</span>`;
            } else {
                hostMobilePeerLabel.textContent = "0 clients connected";
            }
        }
    }

    // Subscribe to Peers changes
    Peers.onchange((map) => {
        // 1. Host side: show number of clients connected (not client ID)
        const connectedClients = Array.from(map.entries()).filter(
            ([id, peer]) =>
                id !== PEER_ID &&
                peer.conn.connectionState === "connected" &&
                knownRoomPeers.get(id)?.role !== "proxy",
        );
        updateHostPeerUI(connectedClients.length);

        // 2. Client side: show the host peer ID (or waiting)
        const hostEntry = Array.from(map.entries()).find(
            ([id, peer]) =>
                id !== PEER_ID &&
                peer.conn.connectionState === "connected" &&
                knownRoomPeers.get(id)?.role === "proxy",
        );

        if (hostEntry) {
            updateClientPeerUI(hostEntry[0]);
        } else {
            updateClientPeerUI(null);
        }

        // ONLY broadcast ready when there is an active CONNECTED WebRTC connection!
        const hasConnectedPeer = Array.from(map.values()).some(
            (p) => p.conn.connectionState === "connected",
        );
        if (hasConnectedPeer && tunnelChannel) {
            tunnelChannel.postMessage({ type: "ready", roomId: roomName });
        }
    });

    // Helper: wait for a connected peer if ICE negotiation is currently finishing
    async function waitForConnectedPeer(timeoutMs = 2500): Promise<boolean> {
        const check = () =>
            Array.from(Peers.map.values()).some(
                (p) => p.conn.connectionState === "connected",
            );
        if (check()) return true;

        return new Promise((resolve) => {
            const timer = setTimeout(() => {
                cleanup();
                resolve(check());
            }, timeoutMs);

            const cleanup = Peers.onchange(() => {
                if (check()) {
                    clearTimeout(timer);
                    cleanup();
                    resolve(true);
                }
            });
        });
    }

    // Dispatch request to connected peer
    function dispatchProxyRequest(
        head: ArrayBuffer,
        port: MessagePort,
        hasBody: boolean,
    ): boolean {
        for (const [id, peer] of Peers.map) {
            if (peer.conn.connectionState === "connected") {
                handleClientProxyRequest(peer.conn, head, port, hasBody);
                return true;
            }
        }
        return false;
    }

    async function handleProxyRequestMessage(
        data: any,
        ports: readonly MessagePort[],
    ) {
        if (data?.type === "PROXY_REQUEST_START") {
            const { head, hasBody } = data;
            const reqPort = ports[0];
            if (head && reqPort) {
                // If peer is still negotiating (ICE handshake), give it up to 2.5s to finish
                let sent = dispatchProxyRequest(head, reqPort, hasBody);
                if (!sent) {
                    const isReady = await waitForConnectedPeer(2500);
                    if (isReady) {
                        sent = dispatchProxyRequest(head, reqPort, hasBody);
                    }
                }

                if (!sent) {
                    console.warn(
                        "[Hub] No connected WebRTC peer! Sending RESPONSE_ERROR",
                    );
                    reqPort.postMessage({ type: "RESPONSE_ERROR" });
                    reqPort.close();
                }
            }
        }
    }

    // Register Service Worker and listen for tunnel requests directly
    async function initServiceWorkerBridge() {
        if (!("serviceWorker" in navigator)) {
            console.warn("[Hub] ServiceWorker not supported in this browser");
            return;
        }

        try {
            await navigator.serviceWorker.register("/sw.js", {
                scope: "/",
            });
            await navigator.serviceWorker.ready;

            navigator.serviceWorker.addEventListener("message", (ev) => {
                handleProxyRequestMessage(ev.data, ev.ports);
            });
            console.log(
                `[Hub] SW registered and listening directly for room '${roomName}'`,
            );
        } catch (err) {
            console.error(
                "[Hub] Failed to initialize Service Worker bridge:",
                err,
            );
        }
    }

    initServiceWorkerBridge();

    // Fallback for cross-window messaging if needed
    window.addEventListener("message", (ev) => {
        handleProxyRequestMessage(ev.data, ev.ports);
    });
</script>

<style>
    .proxy-page {
        max-width: 980px;
        margin: 0 auto;
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    /* Header */
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    /* Tab Navigation matching room.astro */
    .tab-nav {
        display: flex;
        padding: 4px 0;
        gap: 8px;
        width: fit-content;
    }

    .tab-btn {
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        padding: 0.5rem;
        color: var(--text-secondary);
        background: transparent;
        border: none;
        cursor: pointer;
        transition:
            color 0.15s ease,
            background-color 0.15s ease;
    }

    .tab-btn:hover {
        color: var(--text-primary);
    }

    .tab-btn.active {
        text-decoration: underline;
        color: var(--accent-text);
    }

    .tab-pane {
        display: flex;
        flex-direction: column;
    }

    .tab-pane[hidden] {
        display: none;
    }

    .room-indicator {
        font-size: 13px;
        color: var(--text-muted);
    }

    .room-indicator strong {
        color: var(--accent-text);
    }

    .peer-status {
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        font-weight: 500;
        color: var(--text-muted);
        background: transparent;
        border: none;
        padding: 0;
    }

    .peer-status.connected {
        color: #a6e3a1; /* Catppuccin Green */
    }

    /* Content & Cards */
    .proxy-content {
        display: flex;
        flex-direction: column;
    }

    .card {
        width: 100%;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .card-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-tag {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.05em;
        color: var(--text-muted);
    }

    .badge {
        font-size: 11px;
        color: var(--accent-text);
        background: var(--bg-input);
        padding: 3px 8px;
        border-radius: 6px;
        border: 1px solid var(--border-subtle);
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .field-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .label {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }

    .input {
        width: 100%;
        background: var(--bg-input);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 10px 14px;
        color: var(--text-primary);
        font-size: 13px;
        outline: none;
        transition: border-color 0.15s ease;
    }

    .input:focus {
        border-color: var(--border-focus);
    }

    .input-with-action {
        display: flex;
        gap: 8px;
    }

    .hint-text {
        font-size: 12px;
        color: var(--text-secondary);
        line-height: 1.4;
    }

    .actions-row {
        margin-top: 14px;
        width: 100%;
    }

    /* Two-Column Layout & Peer Panel matching room.astro */
    .proxy-layout {
        display: grid;
        grid-template-columns: 1fr 240px;
        gap: 24px;
        align-items: stretch;
        width: 100%;
    }

    .client-layout {
        display: grid;
        grid-template-columns: 1fr 240px;
        gap: 24px;
        align-items: start;
        width: 100%;
    }

    .proxy-main-col,
    .client-main-col {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .peer-panel {
        background-color: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 10px;
        padding: 18px;
        width: 100%;
        max-width: 240px;
    }

    .host-peer-panel {
        display: flex;
        flex-direction: column;
        border-radius: 12px;
    }

    .client-count-wrapper {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .client-count-number {
        font-size: 48px;
        font-weight: 700;
        color: var(--accent-text);
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .panel-title {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        font-family: var(--font-mono);
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    .peer-name {
        font-size: 12px;
        font-weight: 600;
        color: var(--accent-text);
    }

    .mobile-peer {
        display: none;
    }

    @media (max-width: 720px) {
        .proxy-layout,
        .client-layout {
            grid-template-columns: 1fr;
            gap: 14px;
            display: flex;
            flex-direction: column;
        }

        .peer-panel {
            display: none;
        }

        .mobile-peer {
            display: block;
            margin-left: auto;
            background-color: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            width: fit-content;
            padding: 8px 14px;
            border-radius: 8px;
            margin-bottom: 14px;
            box-shadow: var(--shadow-sm);
        }

        .mobile-peer-label {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 13px;
            color: var(--accent-text);
            font-weight: 500;
        }

        .mobile-peer-label .peer-id-val {
            color: var(--accent-text);
            font-weight: 700;
        }
    }

    /* Buttons using strict theme tokens */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: background-color 0.15s ease;
    }

    .btn-primary {
        width: 100%;
        background: var(--accent-primary);
        color: var(--text-on-accent);
    }

    .btn-client-theme {
        background: #82aaff !important;
        color: #0d1117 !important;
        font-weight: 700 !important;
    }

    .btn-client-theme:hover {
        background: #6e9bf7 !important;
    }

    .btn-secondary {
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        padding: 8px 14px;
        outline: none;
        transition:
            background-color 0.15s ease,
            border-color 0.15s ease,
            color 0.15s ease;
    }

    .btn-secondary:hover {
        background: color-mix(in srgb, var(--bg-surface-elevated) 65%, #000000);
        border-color: var(--border-subtle);
        color: var(--text-primary);
    }

    .btn-secondary:focus {
        outline: none;
    }

    .btn-secondary:focus-visible {
        outline: 1px solid var(--border-focus);
    }

    .mono-font {
        font-family: var(--font-mono);
    }

    /* Request Log Section */
    .log-section {
        margin-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .log-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 2px;
    }

    .log-title {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }

    .btn-clear {
        background: transparent;
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .btn-clear:hover {
        color: var(--text-primary);
        border-color: var(--border-focus);
    }

    .log-grid-container {
        max-height: 42vh;
        overflow-y: auto;
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        background: var(--bg-input);
    }

    .log-empty {
        padding: 28px 16px;
        text-align: center;
        color: var(--text-muted);
        font-size: 13px;
    }

    .log-grid {
        display: flex;
        flex-direction: column;
        width: 100%;
        min-width: 620px;
    }

    .log-grid-header {
        display: grid;
        grid-template-columns: 48px 68px 60px 1fr 64px;
        column-gap: 18px;
        align-items: center;
        padding: 8px 18px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--text-primary);
        background: var(--bg-surface-elevated);
        border-bottom: 1px solid var(--border-subtle);
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* Target dynamically generated log rows */
